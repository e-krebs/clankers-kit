{
  "SessionStart": [
    { "hooks": [ { "type": "command", "command": "bash \"/R/hooks/shared-a.sh\"", "timeout": 5 } ] },
    { "hooks": [ { "type": "command", "command": "bash \"/R/skills/beta/hooks/beta-start.sh\"", "timeout": 5 } ] }
  ],
  "SessionEnd": [
    { "hooks": [ { "type": "command", "command": "bash \"/R/hooks/shared-a.sh\"", "timeout": 3 } ] }
  ],
  "PermissionRequest": [
    { "hooks": [ { "type": "command", "command": "afplay /S/x.aiff >/dev/null 2>&1 &", "timeout": 5 } ] }
  ],
  "PreToolUse": [
    { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash \"/R/hooks/shared-c.sh\" codex", "timeout": 5 } ] }
  ],
  "UserPromptSubmit": [
    { "hooks": [ { "type": "command", "command": "bash \"/R/skills/alpha/hooks/alpha-nudge.sh\"", "timeout": 5 } ] }
  ],
  "PostToolUse": [
    { "matcher": "Bash", "hooks": [ { "type": "command", "command": "echo inline", "timeout": 5 } ] }
  ]
}
