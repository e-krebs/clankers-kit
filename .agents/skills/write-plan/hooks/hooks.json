{
  "hooks": {
    "PreToolUse": [
      { "matcher": "ExitPlanMode", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/skills/write-plan/hooks/plan-gate.sh", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/skills/write-plan/hooks/plan-nudge.sh", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "matcher": "ExitPlanMode", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/skills/write-plan/hooks/plan-followthrough.sh", "timeout": 5 } ] }
    ]
  }
}
