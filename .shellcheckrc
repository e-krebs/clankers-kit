# Follow `source` lines into lib/ (each hook names its library with a `# shellcheck source=`
# directive), so a variable a hook sets for a sourced library (HOOK_SESSION) is seen as used and
# the library is checked in context. A directive resolves against the entry script's dir, so the
# second path lets a skill hook's prompt-guards.sh reach its sibling hook-log.sh (two hops).
external-sources=true
source-path=SCRIPTDIR
source-path=SCRIPTDIR/../../../hooks/lib
